APP_ENV=development
APP_NAME=NahaLabs Content OS API
API_PREFIX=/api/v1
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nahalabs_content_os
REDIS_URL=redis://localhost:6379/0
AWS_REGION=af-south-1
AWS_S3_BUCKET=nahalabs-content-os-dev
AWS_S3_UPLOAD_EXPIRY_SECONDS=900
AWS_SQS_GENERATION_QUEUE_URL=
AWS_SQS_MEDIA_QUEUE_URL=
COGNITO_REGION=af-south-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_API_BASE_URL=https://zernio.com/api/v1
KIE_API_BASE_URL=
KIE_API_KEY=
KIE_SUBMIT_PATH=/v1/generations
KIE_STATUS_PATH=/v1/generations/{job_id}
KIE_DEFAULT_MODEL=auto
GENERATION_DEMO_MODE=true
GENERATION_MAX_COST_PER_ASSET=0.50
HIGGSFIELD_API_BASE_URL=
HIGGSFIELD_API_KEY=
HIGGSFIELD_DEMO_ENABLED=false
MPT_ENABLED=false
MPT_ROOT=
MPT_PYTHON=python
MPT_TIMEOUT_SECONDS=1200
MAX_UPLOAD_BYTES=524288000
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/webm
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png,image/webp
